<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Security: Block direct access to sensitive Laravel backend files & folders
    RewriteRule ^backend/\.env - [F,L]
    RewriteRule ^backend/(app|bootstrap|config|database|resources|routes|storage|tests|vendor) - [F,L]

    # 2. Uploaded Media Files: Route /uploads directly to backend/public/uploads
    RewriteRule ^uploads/(.*)$ backend/public/uploads/$1 [L]

    # 3. Uploaded Storage Files: Route /storage directly to backend/storage/app/public
    RewriteRule ^storage/(.*)$ backend/storage/app/public/$1 [L]

    # 4. Admin, Rider, API & Utilities: Route directly to Laravel Front Controller (index.php)
    RewriteRule ^(admin|rider|api|run-storage-link|clear-cache)(/.*)?$ backend/public/index.php [L,QSA]

    # 5. React SPA Router: Direct all other non-existing files to index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
